# Copia este archivo a .env.local y rellena los valores reales.
# .env.local y .env.production estan ignorados por git a proposito.

# URL publica del sitio (metadata, canonical, robots y sitemap)
NEXT_PUBLIC_SITE_URL=https://afcrtecnologia.com

# Telefono y WhatsApp.
# Viven en el entorno para no quedar escritos en el repositorio publico.
# OJO: son NEXT_PUBLIC_*, asi que SI aparecen en el HTML del sitio publicado.
# Esto los saca de GitHub; no los oculta de los visitantes (el boton de
# WhatsApp necesita el numero para funcionar).
# Si faltan, la web oculta el telefono y el boton en lugar de publicar un
# enlace roto.
NEXT_PUBLIC_PHONE_DISPLAY=+51 000 000 000
NEXT_PUBLIC_WHATSAPP_NUMBER=51000000000

# Destino del formulario. Solo hace falta tocarlo en el build estatico,
# donde `npm run build:static` ya lo fija a /contact.php
# NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Opcional: webhook que recibira los leads del formulario (n8n, Make, Zapier, Slack...)
CONTACT_WEBHOOK_URL=

# Opcional: envio de correo transaccional via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contacto@afcrtecnologia.com
CONTACT_FROM_EMAIL=web@afcrtecnologia.com
